Proceso UD03A024
	Definir n1,n2,n3 Como Entero;
	Escribir "Introduzca un número: ";
	Leer n1;
	Escribir "Introduzca otro número: ";
	Leer n2;
	Escribir "Introduzca otro número: ";
	Leer n3;
	
	
	Si n1-n2=n2-n3 Entonces
		Escribir "Es una progresión arimética";
	SiNo
		Escribir "No es una progresión arimética";
	FinSi
	
FinProceso
